# Copy to .env and adjust. Every setting has a working default (src/airbnb_lakehouse/config.py).
# The Makefile reads .env. Keep comments on their own lines. No secret is needed for local runs.

# ---------------------------------------------------------------- data + source
# Where landing, lake (Iceberg), warehouse (DuckDB) and state live. Keep it outside the repo.
AIRBNB_DATA_DIR=./data
# insideairbnb (live download) or fixtures (the sampled real-data fixtures built by `make fixtures`)
AIRBNB_SOURCE=insideairbnb
AIRBNB_CITIES=amsterdam,austin,singapore
AIRBNB_SNAPSHOTS_PER_CITY=2
AIRBNB_HTTP_TIMEOUT=120

# ---------------------------------------------------------------- emulated AWS
# local = filesystem laid out like S3; s3 = boto3 (moto/LocalStack via AWS_ENDPOINT_URL)
AIRBNB_STORAGE=local
# sql = SQLite Iceberg catalog (Glue stand-in); glue = AWS Glue Data Catalog
AIRBNB_CATALOG=sql
AIRBNB_LAKE_BUCKET=airbnb-lake-local
# Only for emulators, e.g. LocalStack: http://localhost:4566
# AWS_ENDPOINT_URL=
AWS_REGION=eu-west-1

# ---------------------------------------------------------------- dbt / DuckDB
DBT_TARGET=dev
AIRBNB_DBT_THREADS=4
AIRBNB_DUCKDB_MEMORY_LIMIT=4GB

# ---------------------------------------------------------------- misc
AIRBNB_LOG_LEVEL=INFO
# text or json
AIRBNB_LOG_FORMAT=text
# Chrome/Chromium binary for `airbnb verify --capture` (auto-detected when unset)
# AIRBNB_CHROME=
